{
  "name": "loominate-if",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p scripts && tsc -p examples/branching-story && tsc -p examples/world-model",
    "lint": "eslint . && prettier --check . && node scripts/check-deps.ts && node scripts/release.ts check",
    "format": "prettier --write .",
    "docs:update": "node scripts/snippets.ts --update",
    "test": "vitest run",
    "build": "tsc -b && pnpm --filter \"./examples/*\" build",
    "coverage": "pnpm --filter \"./examples/*\" coverage",
    "api": "tsc -b && node scripts/api-report.ts",
    "api:update": "tsc -b && node scripts/api-report.ts --update"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
