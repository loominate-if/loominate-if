%YAML 1.2
---
# Loominate IF passage files (#413, ADR 0121), after ADR 0004. Inline code is
# TypeScript. The directives are the Tree-sitter grammar's (ADR 0119), longest
# first; scripts/editors.test.ts keeps them in step.
name: Loominate IF
file_extensions: [weft]
scope: source.weft
version: 2

variables:
  directive: '(?:reacts ask or tell|on first visit|ambience stop|show or give|ask or tell|reacts tell|reacts show|reacts give|music stop|reacts ask|reacts yes|page only|storylets|reacts no|on enter|on leave|log only|continue|storylet|ambience|else if|notices|chapter|effect|topics|reveal|music|sound|exits|hello|else|when|line|beat|wait|page|menu|emit|tell|show|give|act|ask|yes|bye|if|in|no)'
  escape: '\\[!-/:-@\[-`{-~]'

contexts:
  main:
    - match: '^(::)[ \t]*([^\[\]{}\\\n]*[^\[\]{}\\\s])?[ \t]*'
      captures:
        1: punctuation.definition.heading.weft
        2: entity.name.section.weft
      push: header
    - match: '^\s*(//).*\n?'
      scope: comment.line.double-slash.weft
      captures:
        1: punctuation.definition.comment.weft
    - include: prose

  header:
    - meta_scope: meta.header.weft markup.heading.weft
    - match: '\['
      scope: punctuation.section.brackets.begin.weft
      set: tags
    - match: '\n'
      pop: 1

  tags:
    - meta_scope: meta.header.weft meta.tags.weft
    - match: '\]'
      scope: punctuation.section.brackets.end.weft
      pop: 1
    - match: ','
      scope: punctuation.separator.sequence.weft
    - match: '([A-Za-z_][\w-]*)\s*(:)\s*([^,\]\n]*)'
      captures:
        1: entity.other.attribute-name.weft
        2: punctuation.separator.key-value.weft
        3: string.unquoted.weft
    - match: '[A-Za-z_][\w-]*'
      scope: entity.other.attribute-name.weft
    - match: '(?=\n)'
      pop: 1

  prose:
    - match: '/\*'
      scope: punctuation.definition.comment.begin.weft
      push: block-comment
    - match: '{{escape}}'
      scope: constant.character.escape.weft
    - match: '(\*\*)(\S(?:[^*\n]*\S)?)(\*\*)'
      captures:
        0: markup.bold.weft
        1: punctuation.definition.bold.begin.weft
        3: punctuation.definition.bold.end.weft
    - match: '(\*)(\S(?:[^*\n]*\S)?)(\*)'
      captures:
        0: markup.italic.weft
        1: punctuation.definition.italic.begin.weft
        3: punctuation.definition.italic.end.weft
    - match: '\[\[(?=[^\]\n]*->)'
      scope: punctuation.definition.link.begin.weft
      push: link-label
    - match: '\[\['
      scope: punctuation.definition.link.begin.weft
      push: link-target
    - include: inline

  inline:
    - match: '(\{)(/if)(\})'
      captures:
        1: punctuation.section.braces.begin.weft
        2: keyword.control.directive.weft
        3: punctuation.section.braces.end.weft
    - match: '(\{)({{directive}})(?=[ ,:}])'
      captures:
        1: punctuation.section.braces.begin.weft
        2: keyword.control.directive.weft
      push: directive
    - match: '\{'
      scope: punctuation.section.braces.begin.weft
      embed: scope:source.ts
      embed_scope: meta.embedded.weft source.ts.embedded.weft
      escape: '\}'
      escape_captures:
        0: punctuation.section.braces.end.weft

  directive:
    - meta_scope: meta.directive.weft
    - match: '\}'
      scope: punctuation.section.braces.end.weft
      pop: 1
    - match: '[ \t]*(->)[ \t]*([^,}\n]*[^,}\s])'
      captures:
        1: keyword.operator.arrow.weft
        2: entity.name.label.passage.weft
    - match: '[ ,:]'
      embed: scope:source.ts
      embed_scope: meta.embedded.weft source.ts.embedded.weft
      escape: '(?=\})'

  link-label:
    - meta_scope: meta.link.weft
    - match: '->'
      scope: keyword.operator.arrow.weft
      set: link-target
    - match: '{{escape}}'
      scope: constant.character.escape.weft
    - include: inline
    - match: '[^\]\-{\\\n]+|-'
      scope: string.other.link.title.weft
    - match: '(?=\n)'
      pop: 1

  link-target:
    - meta_scope: meta.link.weft
    - match: '\]\]'
      scope: punctuation.definition.link.end.weft
      pop: 1
    - match: '[^\]\n]+'
      scope: entity.name.label.passage.weft markup.underline.link.weft
    - match: '(?=\n)'
      pop: 1

  block-comment:
    - meta_scope: comment.block.weft
    - match: '\*/'
      scope: punctuation.definition.comment.end.weft
      pop: 1
