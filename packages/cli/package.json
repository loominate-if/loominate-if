{
  "name": "@loominate-if/cli",
  "version": "0.1.0",
  "description": "The `loominate` command: dev server, test runner, builds, story map, coverage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loominate-if/loominate-if.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/loominate-if/loominate-if#readme",
  "bugs": "https://github.com/loominate-if/loominate-if/issues",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "bin": {
    "loominate": "./dist/bin.js"
  },
  "dependencies": {
    "@loominate-if/compiler": "workspace:^",
    "@loominate-if/inspector": "workspace:^",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@loominate-if/core": "workspace:*",
    "vitest": "5.1.0",
    "@loominate-if/testing": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
